# DMSAI Environment Configuration
#
# Copy this file to .env for local development.
# Never commit real API keys, passwords, database URLs, or production secrets.

# Central database
DMSAI_DB_URL=sqlite:///C:/dev/DMSAI/data/dmsai.db

# Document storage and watcher folders
DMSAI_STORAGE_ROOT=C:/dev/DMSAI/data/storage/documents
DMSAI_INBOX_DIR=C:/dev/DMSAI/data/inbox
DMSAI_PROCESSED_DIR=C:/dev/DMSAI/data/processed
DMSAI_MODELS_DIR=C:/dev/DMSAI/data/models

# Gateway security
# Set strong random values before exposing the API beyond localhost.
DMSAI_JWT_SECRET=change-me-generate-a-long-random-secret
DMSAI_INTERNAL_API_KEY=change-me-generate-a-long-random-internal-key

# LLM providers
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:27b

# Node-to-node and gateway-to-node URLs (override when running in Docker)
# INGESTION_NODE_URL=http://localhost:8010
# OCR_NODE_URL=http://localhost:8013
# ENTITY_EXTRACTION_NODE_URL=http://localhost:8015
# API_GATEWAY_URL=http://localhost:8080

# LiteLLM / Gemini
# Required only when using LiteLLM models configured in litellm_config.yaml.
GEMINI_API_KEY=replace-with-your-key

# Service ports
INGESTION_NODE_PORT=8010
CONVERSION_NODE_PORT=8011
STORAGE_NODE_PORT=8012
OCR_NODE_PORT=8013
ENTITY_EXTRACTION_NODE_PORT=8015
CLASSIFICATION_NODE_PORT=8016
ENTITY_RESOLUTION_NODE_PORT=8017
FIELD_EXTRACTION_NODE_PORT=8018
API_GATEWAY_PORT=8080

# DMSAI Environment Configuration
#
# Copy this file to .env:
#   cp .env.example .env
#
# The two secrets below are AUTO-GENERATED by `python dmsai.py setup`
# (or on the very first `python dmsai.py start`), so you do NOT need
# to edit them manually for a local setup.
#
# To use Ollama (local, free): just start Ollama and `python dmsai.py start`.
# To use Gemini/cloud: set GEMINI_API_KEY and update LLM settings in the admin UI.

# ---------------------------------------------------------------------------
# Database — PostgreSQL (only supported backend)
# ---------------------------------------------------------------------------
# DMSAI uses PostgreSQL for both native and Docker installs.  The
# installer (`python scripts/install.py` or `python dmsai.py setup`) will
# install Postgres natively (winget / brew / apt / dnf) and provision the
# dmsai role + database automatically.  Docker Compose users get the
# bundled `postgres` service for free.
#
# Change the password below before deploying anywhere reachable outside
# localhost.

DMSAI_DB_URL=postgresql+psycopg://dmsai:dmsai@localhost:5432/dmsai

POSTGRES_USER=dmsai
POSTGRES_PASSWORD=dmsai
POSTGRES_DB=dmsai

# ---------------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------------

DMSAI_STORAGE_ROOT=./data/storage/documents
DMSAI_INBOX_DIR=./data/inbox
DMSAI_PROCESSED_DIR=./data/processed
DMSAI_MODELS_DIR=./data/models

# ---------------------------------------------------------------------------
# Gateway security  (auto-generated on first run — no manual edit needed)
# ---------------------------------------------------------------------------

DMSAI_JWT_SECRET=change-me-generate-a-long-random-secret
DMSAI_INTERNAL_API_KEY=change-me-generate-a-long-random-internal-key

# ---------------------------------------------------------------------------
# LLM provider — Ollama (default, local, free)
# ---------------------------------------------------------------------------
# Requires Ollama installed and running: https://ollama.com
# Pull a model first:  ollama pull gemma3:27b
#
# Smaller alternatives (set LLM_MODEL to one of these):
#   gemma3:12b      (~8 GB VRAM, faster)
#   qwen2.5vl:7b    (~5 GB VRAM, good vision quality)
#   llava:7b        (~4 GB VRAM, lightweight)

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:27b

# ---------------------------------------------------------------------------
# LLM provider — Gemini / LiteLLM (cloud, optional)
# ---------------------------------------------------------------------------
# Uncomment and fill to use Gemini instead of Ollama.
# Then set Provider=litellm and Model=gemini/gemini-3-flash-preview
# in Admin -> LLM Settings.

# GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Node URLs  (only needed for Docker or remote deployments)
# ---------------------------------------------------------------------------
# In Docker these are set automatically via docker-compose.yml.
# Uncomment to override for custom deployments.

# INGESTION_NODE_URL=http://localhost:8010
# CONVERSION_NODE_URL=http://localhost:8011
# STORAGE_NODE_URL=http://localhost:8012
# OCR_NODE_URL=http://localhost:8013
# ENTITY_EXTRACTION_NODE_URL=http://localhost:8015
# CLASSIFICATION_NODE_URL=http://localhost:8016
# ENTITY_RESOLUTION_NODE_URL=http://localhost:8017
# FIELD_EXTRACTION_NODE_URL=http://localhost:8018

# ---------------------------------------------------------------------------
# Monitoring (Grafana admin password)
# ---------------------------------------------------------------------------

# GRAFANA_ADMIN_PASSWORD=change-this-password
